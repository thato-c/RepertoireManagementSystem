@using Repertoire_Management_System.ViewModels
@model RehearsalSessionTrialViewModel
@{
    ViewData["Title"] = "Rehearsal";
}

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Artist</th>
            <th>First</th>
            <th>Second</th>
            <th>Third</th>
            <th>Fourth</th>
            <th>Fifth</th>
            <th>Sixth</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.RehearsalSessionSongs.Count; i++)
        {
            <tr>
                <form asp-action="RecordSession" method="post">
                <td>
                    <input type="hidden" asp-for="RehearsalSessionSongs[i].SessionSongId" />
                        @Model.RehearsalSessionSongs[i].Title
                </td>
                <td>
                        @Model.RehearsalSessionSongs[i].Artist
                </td>
                <td>
                    <select asp-for="RehearsalSessionSongs[i].FirstTrial"
                            asp-items="Model.TrialOptions" class="form-control"></select>
                </td>
                <td>
                    <select asp-for="RehearsalSessionSongs[i].SecondTrial"
                            asp-items="Model.TrialOptions" class="form-control"></select>
                </td>
                <td>
                    <select asp-for="RehearsalSessionSongs[i].ThirdTrial"
                            asp-items="Model.TrialOptions" class="form-control"></select>
                </td>
                <td>
                    <select asp-for="RehearsalSessionSongs[i].FourthTrial"
                            asp-items="Model.TrialOptions" class="form-control"></select>
                </td>
                <td>
                    <select asp-for="RehearsalSessionSongs[i].FifthTrial"
                            asp-items="Model.TrialOptions" class="form-control"></select>
                </td>
                <td>
                    <select asp-for="RehearsalSessionSongs[i].SixthTrial"
                            asp-items="Model.TrialOptions" class="form-control"></select>
                </td>
                <td>
                    <button type="submit">Record</button>
                </td>
                </form>

            </tr>
        }
    </tbody>
</table>