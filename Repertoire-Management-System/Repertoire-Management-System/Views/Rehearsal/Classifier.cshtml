@using Repertoire_Management_System.ViewModels
@model SongClassAssignmentViewModel
@{
    ViewData["Title"] = "Classification System";
}

<a asp-controller="Rehearsal" asp-action="CreateSession">Create a Session</a>

<table class="table">
    <theadd>
        <tr>
            <th>Title</th>
            <th>Artist</th>
            <th>Class</th>
        </tr>
    </theadd>
    <tbody>
        @for (int i = 0; i < Model.Songs.Count; i++)
        {
            <tr>
                <input type="hidden" asp-for="Songs[i].SongId" />
                <td>
                    @Model.Songs[i].Title
                </td>
                <td>
                    @Model.Songs[i].Artist
                </td>
                <td>
                    <select asp-for="Songs[i].SelectedClass" 
                            asp-items="Model.SongClassOptions" 
                            class="form-control">
                    </select>
                </td>
            </tr>
        }
    </tbody>
</table>