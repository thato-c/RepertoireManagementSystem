@using Repertoire_Management_System.ViewModels
@model RehearsalSessionTrialViewModel
@{
    ViewData["Title"] = "Rehearsal";
}

<form>
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Artist</th>
                <th>First</th>
                <th>Second</th>
                <th>Third</th>
                <th>Fourth</th>
                <th>Fifth</th>
                <th>Sixth</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.RehearsalSession.Count; i++)
            {
                <tr>
                    <input type="hidden" asp-for="RehearsalSession[i].SongId" />
                    <td>
                        @Model.RehearsalSession[i].Title
                    </td>
                    <td>
                        @Model.RehearsalSession[i].Artist
                    </td>
                    <td>
                        <select asp-for="RehearsalSession[i].FirstTrial" 
                        asp-items="Model.TrialOptions" class="form-control"></select>
                    </td>
                    <td>
                        <select asp-for="RehearsalSession[i].SecondTrial" 
                        asp-items="Model.TrialOptions" class="form-control"></select>
                    </td>
                    <td>
                        <select asp-for="RehearsalSession[i].ThirdTrial"
                                asp-items="Model.TrialOptions" class="form-control"></select>
                    </td>
                    <td>
                        <select asp-for="RehearsalSession[i].FourthTrial"
                                asp-items="Model.TrialOptions" class="form-control"></select>
                    </td>
                    <td>
                        <select asp-for="RehearsalSession[i].FifthTrial"
                                asp-items="Model.TrialOptions" class="form-control"></select>
                    </td>
                    <td>
                        <select asp-for="RehearsalSession[i].SixthTrial"
                                asp-items="Model.TrialOptions" class="form-control"></select>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</form>