@model IEnumerable<Repertoire_Management_System.Models.RehearsalSession>

<a asp-controller="Rehearsal" asp-action="CreateSession">Create a Session</a>

@if (Model != null)
{
    <table class="table">
        <thead>
            <tr>
                <td>Name</td>
                <td>Initiate</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var rehearsalSession in Model)
            {
                <tr>
                    <td>@rehearsalSession.Name</td>
                    <td>
                        <a asp-controller="Rehearsal" asp-action="GetSessionById" asp-route-Sessionid="@rehearsalSession.RehearsalSessionId">Initiate</a>
                    </td>
                </tr>

            }
        </tbody>
    </table>
}
else
{
    <p>@ViewBag.Message</p>
}
