@using Repertoire_Management_System.ViewModels
@model CreateSessionViewModel

@if (Model != null)
{
    <form asp-controller="Rehearsal" asp-action="PostCreateSession" method="post">
        <div class="form-group">
            <label asp-for="SessionName">Name</label>
            <input asp-for="SessionName" class="form-control" />
            <span asp-validation-for="SessionName" class="text-danger"></span>
        </div>
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Artist</th>
                    <th>Class</th>
                    <th>Selected</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.SessionSongs.Count; i++)
                {
                    <tr>
                        <td>
                            @Model.SessionSongs[i].Title
                            <input type="hidden" asp-for="SessionSongs[i].SongId" />
                        </td>
                        <td>
                            @Model.SessionSongs[i].Artist
                        </td>
                        <td>
                            @Model.SessionSongs[i].Class
                        </td>
                        <td>
                            <input asp-for="SessionSongs[i].IsSelected" class="form-check-input" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <button type="submit">Create a Session</button>
    </form>
}
else
{
    <p>@ViewBag.Message</p>
}