@model List<Song>
@{
    ViewData["Title"] = "Song Library";
}

@if (Model != null)
{
    <table class="table">
        <tr>
            <th>Name</th>
            <th>Artist</th>
        </tr>
        @foreach (var song in Model)
        {
            <tr>
                <td>@song.Title</td>
                <td>@song.Artist</td>
            </tr>
        }
    </table>
}
else
{
    <p>@ViewBag.Message</p>
}